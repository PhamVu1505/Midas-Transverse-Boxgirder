; NAME=NAME, 1, iTYPE, BRIDGETYPE, P                                                  ; standard (CONCENTRATED LOAD (W/O OTHER LOADS))
; NAME=NAME, 2, iTYPE, W, nDYNAFAC, dDYNAFAC, dDYNAFAC_UDL                            
