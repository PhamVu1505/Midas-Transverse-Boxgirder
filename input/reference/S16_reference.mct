; [LOAD7] : TL1, TL2, TL3, UL1, UL2, UL3, UL4                                         ; tandem/udl loads
; [LOADCASE] : bUSE, N, bDF, bUI, PHI, P1, L1, P2, L2, ...                            ; load case
